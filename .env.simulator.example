# Uses real AWS. Inherit AWS/queue/bucket settings from .env or AWS CLI profile.
# To isolate the test, override H3_QUEUE_URL/H3_S3_BUCKET/H3_S3_PREFIX/H3_STATUS_PREFIX/H3_PUBLIC_BASE_URL here.
# Do not run a real GPU worker against the same queue while simulating.
H3_SIM_PROFILE=6000-maxq
# 1 = measured wall time; 0.01 = quick smoke test, not real queue latency.
H3_SIM_TIME_SCALE=1
H3_SIM_IMAGE_SIZE=1080x1920
H3_SIM_PORT=8021
H3_SIM_EXPECTED_TASKS=50
# H3_SIM_WORKER_ID=local-sim-machine-1
# H3_SIM_VENV_DIR=/absolute/path/.venv-simulator
# H3_SIM_WORK_DIR=/absolute/path/data/simulator
# H3_SIM_LOG_DIR=/absolute/path/logs/simulator
