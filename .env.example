# Runtime credentials/secrets are injected by the host/role, never committed here.
AWS_REGION=us-east-1
H3_S3_BUCKET=
H3_S3_PREFIX=video/wan22/
# Must match the EXISTING Wan Lambda STATUS_PREFIX. It is independent of video placement.
STATUS_PREFIX=video/wan22/
# CDN origin base without video/h3 suffix
H3_PUBLIC_BASE_URL=
H3_QUEUE_URL=
# Exact hosts or suffixes such as .example.com. Private callbacks require an explicit host.
H3_IMAGE_HOSTS=
H3_WEBHOOK_HOSTS=
H3_MAX_QUEUE=0
# Optional DynamoDB control plane. Empty keeps the existing S3 status mode.
H3_DYNAMODB_TABLE=
H3_CONTROL_NAMESPACE=h3
H3_CAPACITY_PROFILE=6000-s
H3_ADMISSION_LIMIT_SECONDS=780
H3_ADMISSION_MAX_TASKS=18
H3_WORKER_STALE_SECONDS=90
H3_TASK_LEASE_SECONDS=180
H3_TASK_RETENTION_SECONDS=2592000
H3_STALL_SECONDS=2700
H3_PHASE_TIMEOUT=3600
H3_MIN_FREE_GIB=88
H3_ATTENTION=_native_cudnn
# resident: BF16 on CPU with alternating GPU placement.
# dual_int8: experimental TorchAO INT8WO conditioner + transformer, both stay on one GPU.
# int8_encoder_offload: INT8WO generator stays on GPU; text encoder returns to CPU after conditioning.
# Recommended for longer 720p/1080p requests on a single 96 GB GPU; GPU validation required.
H3_MODEL_LIFETIME=resident
# dual_gpu: GPU 0 = INT8 conditioner + local SR; GPU 1 = INT8 generator + VAEs.
# Requires two visible GPUs, downloads the SR weight during deploy.
H3_CONDITION_GPU=0
H3_GENERATE_GPU=1
# H3_SR_MODEL=/workspace/server_h3/models/realesr-general-x4v3.pth
H3_RESIDENT_MIN_RAM_GIB=160
# dual_int8 refuses startup if static placement leaves less than this much free VRAM.
H3_DUAL_MIN_FREE_GIB=8
# Verify hashes once, then reuse only while file identity/stat and expected hashes match.
H3_VERIFY_MODE=cached
# Save converted Eros locally once (~62 GiB); reuse on later resident restarts.
H3_CONVERTED_CACHE=1
# deploy.sh prompts/validates/saves AWS credentials unless explicitly disabled.
H3_AWS_SETUP=1
# Default 8, capped by CPU affinity and the visible cgroup cpu.max quota.
H3_CPU_THREADS=8
# Text + structured logs rotate by size. Details in docs/SUPERVISOR.md.
# H3_LOG_DIR=/workspace/server_h3/logs
H3_LOG_LEVEL=INFO
H3_LOG_MAX_MB=20
H3_LOG_BACKUPS=10
# Optional stable label; by default vast-$CONTAINER_ID or host-$HOSTNAME.
# H3_WORKER_ID=vast-12345678
# Drain in-flight jobs before cancellation; Supervisor adds a 60s cleanup margin.
H3_SHUTDOWN_GRACE=900
H3_STARTUP_TIMEOUT=3600
H3_RESTART_LIMIT=3
H3_RESTART_WINDOW=3600
H3_MIN_DISK_GIB=5
H3_MIN_RAM_GIB=4
H3_REPORT_RETENTION_DAYS=30
H3_REPORT_MAX_MB=500
# Worker probes bind locally. Keep using the already deployed Wan Lambda/API.
H3_BIND=127.0.0.1
H3_PORT=8001
# 1080p: native 720p -> S3 staging -> dedicated upscale queue.
# Must match UPSCALER_STAGING_PREFIX on the upscale machine.
H3_UPSCALE_QUEUE_URL=
H3_STAGING_PREFIX=video/wan22/staging/
