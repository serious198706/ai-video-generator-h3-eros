# Runtime credentials/secrets are injected by the host/role, never committed here.
AWS_REGION=us-east-1
H3_S3_BUCKET=
H3_S3_PREFIX=video/h3/
# CDN origin base without video/h3 suffix
H3_PUBLIC_BASE_URL=
H3_QUEUE_URL=
# Exact hosts or suffixes such as .example.com. Private callbacks require an explicit host.
H3_IMAGE_HOSTS=
H3_WEBHOOK_HOSTS=
H3_MAX_QUEUE=0
H3_STALL_SECONDS=2700
H3_PHASE_TIMEOUT=3600
H3_MIN_FREE_GIB=88
H3_ATTENTION=_native_cudnn
# Worker probes bind locally; API Gateway fronts the separate Lambda API.
H3_BIND=127.0.0.1
H3_PORT=8001
