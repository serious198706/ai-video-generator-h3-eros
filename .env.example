# Runtime credentials/secrets are injected by the host/role, never committed here.
AWS_REGION=us-east-1
H3_S3_BUCKET=
H3_S3_PREFIX=video/h3/
# CDN origin base without video/h3 suffix
H3_PUBLIC_BASE_URL=
H3_QUEUE_URL=
# Exact hosts or suffixes such as .example.com. Private callbacks require an explicit host.
H3_IMAGE_HOSTS=
H3_WEBHOOK_HOSTS=
H3_MAX_QUEUE=0
H3_STALL_SECONDS=2700
H3_PHASE_TIMEOUT=3600
H3_MIN_FREE_GIB=88
H3_ATTENTION=_native_cudnn
# Server default: load once, keep both pipelines on CPU, alternate GPU placement.
H3_MODEL_LIFETIME=resident
H3_RESIDENT_MIN_RAM_GIB=160
# Verify hashes once, then reuse only while file identity/stat and expected hashes match.
H3_VERIFY_MODE=cached
# Save converted Eros locally once (~62 GiB); reuse on later resident restarts.
H3_CONVERTED_CACHE=1
# deploy.sh prompts/validates/saves AWS credentials unless explicitly disabled.
H3_AWS_SETUP=1
# Worker probes bind locally; API Gateway fronts the separate Lambda API.
H3_BIND=127.0.0.1
H3_PORT=8001
